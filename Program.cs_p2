using System;

class Program
{
    static void Main()
    {
        Product[] products = new Product[]
        {
            new Product { Id = 1, Name = "Television", Price = 30000, RemainingStock = 5 },
            new Product { Id = 2, Name = "Washing Machine", Price = 5000, RemainingStock = 10 },
            new Product { Id = 3, Name = "Speaker", Price = 800, RemainingStock = 7 },
            new Product { Id = 4, Name = "Refrigerator", Price = 13000, RemainingStock = 3 }
        };

        string[] orderHistory = new string[20];
        Receipt[] receipts = new Receipt[20];
        int historyCount = 0;
        int receiptNumber = 1;

        CartItem[] cart = new CartItem[10];
        int cartCount = 0;

        while (true)
        {
            Console.WriteLine("\n========== PRODUCT LIST ==========");
            foreach (var p in products)
                p.DisplayProduct();

            Console.WriteLine("\n=== MAIN MENU ===");
            Console.WriteLine("1. Buy Products");
            Console.WriteLine("2. Cart Management");
            Console.WriteLine("3. Order History");
            Console.WriteLine("0. Exit");

            Console.Write("Choose: ");
            if (!int.TryParse(Console.ReadLine(), out int choice))
            {
                Console.WriteLine("Invalid input.");
                continue;
            }

            if (choice == 1)
            {
                Console.Write("Enter product number: ");
                if (!int.TryParse(Console.ReadLine(), out int num) || num < 1 || num > products.Length)
                {
                    Console.WriteLine("Invalid.");
                    continue;
                }

                Product selected = products[num - 1];

                Console.Write("Enter quantity: ");
                if (!int.TryParse(Console.ReadLine(), out int qty) || qty <= 0)
                {
                    Console.WriteLine("Invalid quantity.");
                    continue;
                }

                if (qty > selected.RemainingStock)
                {
                    Console.WriteLine("Not enough stock.");
                    continue;
                }

                bool found = false;
                for (int i = 0; i < cartCount; i++)
                {
                    if (cart[i].Product.Id == selected.Id)
                    {
                        cart[i].Quantity += qty;
                        cart[i].UpdateSubtotal();
                        found = true;
                        break;
                    }
                }

                if (!found)
                {
                    cart[cartCount] = new CartItem
                    {
                        Product = selected,
                        Quantity = qty
                    };
                    cart[cartCount].UpdateSubtotal();
                    cartCount++;
                }

                selected.RemainingStock -= qty;
                Console.WriteLine("Added to cart!");
            }

            else if (choice == 2)
            {
                while (true)
                {
                    Console.WriteLine("\n========== CART MANAGEMENT ==========");
                    Console.WriteLine("1. View Cart");
                    Console.WriteLine("2. Update Quantity");
                    Console.WriteLine("3. Remove Item");
                    Console.WriteLine("4. Clear Cart");
                    Console.WriteLine("5. Checkout");
                    Console.WriteLine("6. Back");

                    Console.Write("Choose: ");
                    if (!int.TryParse(Console.ReadLine(), out int cartChoice))
                    {
                        Console.WriteLine("Invalid.");
                        continue;
                    }
                    if (cartChoice == 1)
                    {
                        Console.WriteLine("\n========== YOUR CART ==========");

                        if (cartCount == 0)
                        {
                            Console.WriteLine("Cart is empty.");
                            continue;
                        }

                        for (int i = 0; i < cartCount; i++)
                        {
                            Console.WriteLine($"{i + 1}. {cart[i].Product.Name} x{cart[i].Quantity} = ₱{cart[i].Subtotal}");
                        }
                    }
                    else if (cartChoice == 2)
                    {
                        if (cartCount == 0)
                        {
                            Console.WriteLine("Cart is empty.");
                            continue;
                        }

                        Console.WriteLine("\n========== CART ITEMS ==========");
                        for (int i = 0; i < cartCount; i++)
                        {
                            Console.WriteLine($"{i + 1}. {cart[i].Product.Name} x{cart[i].Quantity}");
                        }

                        Console.Write("Select item to update: ");
                        int index = int.Parse(Console.ReadLine());

                        Console.Write("Enter new quantity: ");
                        int newQty = int.Parse(Console.ReadLine());

                        CartItem item = cart[index - 1];
                        int diff = newQty - item.Quantity;

                        if (diff > item.Product.RemainingStock)
                        {
                            Console.WriteLine("Not enough stock.");
                            continue;
                        }

                        item.Product.RemainingStock -= diff;
                        item.Quantity = newQty;
                        item.UpdateSubtotal();

                        Console.WriteLine("Updated!");
                    }
                    else if (cartChoice == 3)
                    {
                        if (cartCount == 0)
                        {
                            Console.WriteLine("Cart is empty.");
                            continue;
                        }

                        Console.WriteLine("\n========== CART ITEMS ==========");
                        for (int i = 0; i < cartCount; i++)
                        {
                            Console.WriteLine($"{i + 1}. {cart[i].Product.Name} x{cart[i].Quantity}");
                        }

                        Console.Write("Select item to remove: ");
                        int index = int.Parse(Console.ReadLine());

                        cart[index - 1].Product.RemainingStock += cart[index - 1].Quantity;

                        for (int i = index - 1; i < cartCount - 1; i++)
                            cart[i] = cart[i + 1];

                        cartCount--;

                        Console.WriteLine("Removed!");
                        }
                   else if (cartChoice == 4)
                   {
                       for (int i = 0; i < cartCount; i++)
                           cart[i].Product.RemainingStock += cart[i].Quantity;

                       cartCount = 0;
                       Console.WriteLine("Cart cleared.");
                   }
                   else if (cartChoice == 5)
                   {
                       if (cartCount == 0)
                       {
                           Console.WriteLine("Cart is empty.");
                           continue;
                       }

                       double total = 0;
                       string items = "";

                       Console.WriteLine("\n========== ORDER SUMMARY ==========");

                       for (int i = 0; i < cartCount; i++)
                       {
                           Console.WriteLine($"{cart[i].Product.Name} x{cart[i].Quantity} = ₱{cart[i].Subtotal}");
                           total += cart[i].Subtotal;
                           items += $"{cart[i].Product.Name} x{cart[i].Quantity} = ₱{cart[i].Subtotal}\n";
                       }

                       double discount = total >= 5000 ? total * 0.10 : 0;
                       double finalTotal = total - discount;

                       Console.WriteLine("\n========== PAYMENT BREAKDOWN ==========");
                       Console.WriteLine($"Subtotal: ₱{total}");
                       Console.WriteLine($"Discount: ₱{discount}");
                       Console.WriteLine($"TOTAL TO PAY: ₱{finalTotal}");

                       double payment;

                       while (true)
                       {
                           Console.Write("Enter payment: ");
                           if (!double.TryParse(Console.ReadLine(), out payment))
                           {
                               Console.WriteLine("Invalid input.");
                               continue;
                           }

                           if (payment < finalTotal)
                           {
                               Console.WriteLine("Insufficient payment.");
                               continue;
                           }

                           break;
                       }

                       double change = payment - finalTotal;

                        receipts[historyCount] = new Receipt
                        {
                            Number = receiptNumber,
                            Date = DateTime.Now,
                            Items = items,
                            Total = total,
                            Discount = discount,
                            FinalTotal = finalTotal,
                            Payment = payment,
                            Change = change
                        };

                        orderHistory[historyCount] =
                            $"Receipt #{receiptNumber:D4} - Final Total: PHP {finalTotal}";

                        historyCount++;
                        receiptNumber++;
                        cartCount = 0;

                        Console.WriteLine($"Change: ₱{change}");
                        break;
                    }

                    else if (cartChoice == 6)
                    {
                        break;
                    }
                }
            }


}
  
